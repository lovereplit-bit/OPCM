# Pins and defaults shared by the build scripts and workflows. Plain shell, safe to source from bash. Every value can be
# overridden from the environment.

# Where the OpenCode sources come from.
: "${UPSTREAM_REPO:=anomalyco/opencode}"

# Base image of the Linux userland that runs inside the app.
: "${UBUNTU_TAG:=24.04}"

# Node.js line installed into the userland for npx-based MCP servers and plugins. The newest release of the line is
# taken from nodejs.org and checked against its SHASUMS256.txt.
: "${NODE_LINE:=22}"

# Termux package repositories, tried in this order, for proot and libtalloc (the userland launcher).
: "${TERMUX_MIRRORS:=https://packages.termux.dev/apt/termux-main https://grimler.se/termux/termux-main https://mirrors.tuna.tsinghua.edu.cn/termux/apt/termux-main}"

# Exact Termux package versions the launcher is built from. Pinned on purpose: the app
# execs these binaries on real phones, so a silently changed upstream build must not ride
# along with an unrelated app release. Bump deliberately after checking the Termux proot
# issue tracker for regressions (5.1.107.99 segfaulted on One UI 8.5, see termux/proot#420;
# 5.1.107.101 is confirmed working on Android 17 / Galaxy S24 Ultra, see termux/proot#422).
: "${PROOT_VERSION:=5.1.107.101}"
: "${LIBTALLOC_VERSION:=2.5.0}"
: "${LIBANDROID_SHMEM_VERSION:=0.7}"
